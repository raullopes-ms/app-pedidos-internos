{
  "expo": {
    "name": "Pedidos Internos",
    "slug": "pedidos-internos",
    "scheme": "pedidos-internos",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 120
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.semalo.pedidosinternos"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "812e76b9-15e3-40c7-bf07-2a810d4f7346"
      }
    }
  }
}
